<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox prefWidth="580.0" fx:controller="it.saimao.jarpackager.CustomDialogController" spacing="15.0" styleClass="dialog-root" stylesheets="@style.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    
    <Label fx:id="titleLabel" styleClass="title-label" text="Dialog Title">
    </Label>
    
    <TextArea fx:id="contentTextArea" editable="false" prefRowCount="13" wrapText="true" />
    
    <Hyperlink fx:id="helpLink" managed="false" visible="false" wrapText="true"/>
    <HBox alignment="CENTER_RIGHT">
        <Button fx:id="okButton" onAction="#onOkClicked" styleClass="primary-button" text="OK" />
    </HBox>
</VBox>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox prefHeight="640.0" prefWidth="760.0" spacing="18.0" styleClass="app-root" stylesheets="@style.css"
      xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="it.saimao.jarpackager.PackagerController">
    <padding>
        <Insets bottom="24.0" left="24.0" right="24.0" top="24.0"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="top-bar">
        <VBox spacing="2.0" HBox.hgrow="ALWAYS">
            <Label styleClass="app-title" text="JAR Packager"/>
            <Label styleClass="app-caption" text="jpackage"/>
        </VBox>

        <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="package-picker">
            <Label styleClass="form-label" text="Output"/>
            <ComboBox fx:id="packageTypeCombo" prefWidth="140.0"/>
        </HBox>

        <Button onAction="#checkJdkInfo" styleClass="secondary-button" text="Check JDK"/>
    </HBox>

    <Separator/>

    <StackPane fx:id="stepContainer" VBox.vgrow="ALWAYS">
        <VBox fx:id="step1" spacing="18.0" styleClass="step-pane">
            <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="step-header">
                <Label styleClass="step-pill" text="1"/>
                <Label styleClass="section-title" text="Application"/>
            </HBox>

            <GridPane hgap="14.0" styleClass="form-grid" vgap="12.0">
                <columnConstraints>
                    <ColumnConstraints minWidth="170.0" prefWidth="170.0"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <HBox fx:id="sourceModeRow" alignment="CENTER_LEFT" spacing="8.0" GridPane.columnSpan="2">
                    <Label minWidth="170.0" styleClass="form-label" text="Source"/>
                    <HBox alignment="CENTER_LEFT" spacing="14.0" HBox.hgrow="ALWAYS">
                        <RadioButton fx:id="fromJarRadioButton" selected="true" text="From JAR"/>
                        <RadioButton fx:id="fromAppImageRadioButton" text="From image folder"/>
                    </HBox>
                </HBox>

                <HBox fx:id="appImageRow" alignment="CENTER_LEFT" spacing="8.0" GridPane.columnSpan="2" GridPane.rowIndex="1">
                    <Label minWidth="170.0" styleClass="form-label" text="App image folder"/>
                    <TextField fx:id="appImageField" HBox.hgrow="ALWAYS"/>
                    <Button onAction="#browseAppImageDir" styleClass="secondary-button" text="Browse"/>
                </HBox>

                <Label fx:id="jarFileLabel" styleClass="required" text="JAR file *" GridPane.rowIndex="2"/>
                <HBox fx:id="jarFileRow" alignment="CENTER_LEFT" spacing="8.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                    <TextField fx:id="jarFileField" HBox.hgrow="ALWAYS"/>
                    <Button onAction="#browseJarFile" styleClass="secondary-button" text="Browse"/>
                </HBox>

                <Label fx:id="inputDirLabel" styleClass="required" text="Input folder *" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                <HBox fx:id="inputDirRow" alignment="CENTER_LEFT" spacing="8.0" GridPane.columnIndex="1" GridPane.rowIndex="3">
                    <TextField fx:id="inputDirField" HBox.hgrow="ALWAYS"/>
                    <Button onAction="#browseInputDir" styleClass="secondary-button" text="Browse"/>
                </HBox>

                <Label styleClass="required" text="Destination *" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                <HBox alignment="CENTER_LEFT" spacing="8.0" GridPane.columnIndex="1" GridPane.rowIndex="4">
                    <TextField fx:id="destDirField" HBox.hgrow="ALWAYS"/>
                    <Button onAction="#browseDestDir" styleClass="secondary-button" text="Browse"/>
                </HBox>

                <Label styleClass="required" text="Application name *" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
                <TextField fx:id="appNameField" GridPane.columnIndex="1" GridPane.rowIndex="5"/>

                <Label fx:id="mainClassLabel" styleClass="required" text="Main class *" GridPane.columnIndex="0" GridPane.rowIndex="6"/>
                <TextField fx:id="mainClassField" GridPane.columnIndex="1" GridPane.rowIndex="6"/>

                <Label fx:id="mainJarLabel" styleClass="required" text="Main JAR *" GridPane.columnIndex="0" GridPane.rowIndex="7"/>
                <TextField fx:id="mainJarField" GridPane.columnIndex="1" GridPane.rowIndex="7"/>

                <Label styleClass="form-label" text="Version" GridPane.columnIndex="0" GridPane.rowIndex="8"/>
                <TextField fx:id="appVersionField" GridPane.columnIndex="1" GridPane.rowIndex="8"/>
            </GridPane>

            <Region VBox.vgrow="ALWAYS"/>

            <HBox alignment="CENTER_RIGHT" styleClass="action-bar">
                <Button onAction="#showStep2" styleClass="primary-button" text="Next"/>
            </HBox>
        </VBox>

        <VBox fx:id="step2" spacing="18.0" styleClass="step-pane" visible="false">
            <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="step-header">
                <Label styleClass="step-pill" text="2"/>
                <Label styleClass="section-title" text="Metadata &amp; Runtime"/>
            </HBox>

            <GridPane hgap="14.0" styleClass="form-grid" vgap="12.0">
                <columnConstraints>
                    <ColumnConstraints minWidth="170.0" prefWidth="170.0"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <Label fx:id="iconLabel" styleClass="form-label" text="Icon" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <HBox fx:id="iconRow" alignment="CENTER_LEFT" spacing="8.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <TextField fx:id="iconField" HBox.hgrow="ALWAYS"/>
                    <Button onAction="#browseIcon" styleClass="secondary-button" text="Browse"/>
                </HBox>

                <Label styleClass="form-label" text="Vendor" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <TextField fx:id="vendorField" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label styleClass="form-label" text="Copyright" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <TextField fx:id="copyrightField" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                <Label styleClass="form-label" text="Description" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                <TextField fx:id="descriptionField" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                <Label styleClass="form-label" text="License" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                <HBox alignment="CENTER_LEFT" spacing="8.0" GridPane.columnIndex="1" GridPane.rowIndex="4">
                    <TextField fx:id="licenseField" HBox.hgrow="ALWAYS"/>
                    <Button onAction="#browseLicense" styleClass="secondary-button" text="Browse"/>
                </HBox>

                <Label fx:id="addModulesLabel" styleClass="form-label" text="Add modules" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
                <TextField fx:id="addModulesField" GridPane.columnIndex="1" GridPane.rowIndex="5"/>

                <Label fx:id="modulePathLabel" styleClass="form-label" text="Module path" GridPane.columnIndex="0" GridPane.rowIndex="6"/>
                <HBox fx:id="modulePathRow" alignment="CENTER_LEFT" spacing="8.0" GridPane.columnIndex="1" GridPane.rowIndex="6">
                    <TextField fx:id="modulePathField" HBox.hgrow="ALWAYS"/>
                    <Button onAction="#browseModulePath" styleClass="secondary-button" text="Browse"/>
                </HBox>

                <Label fx:id="runtimeImageLabel" styleClass="form-label" text="Runtime image" GridPane.columnIndex="0" GridPane.rowIndex="7"/>
                <HBox fx:id="runtimeImageRow" alignment="CENTER_LEFT" spacing="8.0" GridPane.columnIndex="1" GridPane.rowIndex="7">
                    <TextField fx:id="runtimeImageField" HBox.hgrow="ALWAYS"/>
                    <Button onAction="#browseRuntimeImage" styleClass="secondary-button" text="Browse"/>
                </HBox>
            </GridPane>

            <Region VBox.vgrow="ALWAYS"/>

            <HBox alignment="CENTER_RIGHT" spacing="10.0" styleClass="action-bar">
                <Button onAction="#showStep1" styleClass="secondary-button" text="Back"/>
                <Button onAction="#showStep3" styleClass="primary-button" text="Next"/>
            </HBox>
        </VBox>

        <VBox fx:id="step3" spacing="18.0" styleClass="step-pane" visible="false">
            <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="step-header">
                <Label styleClass="step-pill" text="3"/>
                <Label styleClass="section-title" text="Installer Options"/>
            </HBox>

            <GridPane fx:id="windowsInstallerOptionsGrid" hgap="14.0" styleClass="form-grid" vgap="12.0">
                <columnConstraints>
                    <ColumnConstraints minWidth="170.0" prefWidth="170.0"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <Label styleClass="form-label" text="Upgrade UUID" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <TextField fx:id="upgradeUuidField" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Label styleClass="form-label" text="Menu group" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <TextField fx:id="menuGroupField" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label styleClass="form-label" text="Help URL" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <TextField fx:id="winHelpUrlField" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                <Label styleClass="form-label" text="Update URL" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                <TextField fx:id="winUpdateUrlField" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
            </GridPane>

            <VBox spacing="8.0">
                <Label fx:id="javaOptionsLabel" styleClass="form-label" text="Java options"/>
                <VBox fx:id="javaOptionsContainer" spacing="8.0">
                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                        <TextField fx:id="javaOptionsField" HBox.hgrow="ALWAYS"/>
                        <Button onAction="#addJavaOption" styleClass="secondary-button" text="Add option"/>
                    </HBox>
                </VBox>
            </VBox>

            <VBox spacing="10.0">
                <Label styleClass="form-label" text="Windows options"/>
                <FlowPane hgap="12.0" vgap="10.0">
                    <CheckBox fx:id="winShortcutCheckBox" selected="true" text="Desktop shortcut"/>
                    <CheckBox fx:id="winMenuCheckBox" selected="true" text="Start menu"/>
                    <CheckBox fx:id="winDirChooserCheckBox" selected="true" text="Install folder dialog"/>
                    <CheckBox fx:id="winPerUserInstallCheckBox" text="Per-user install"/>
                    <CheckBox fx:id="winShortcutPromptCheckBox" text="Shortcut prompt"/>
                    <CheckBox fx:id="winConsoleCheckBox" text="Console launcher"/>
                </FlowPane>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <HBox alignment="CENTER_RIGHT" spacing="10.0" styleClass="action-bar">
                <Button onAction="#showStep2" styleClass="secondary-button" text="Back"/>
                <Button onAction="#packageApp" styleClass="primary-button" text="Package"/>
            </HBox>
        </VBox>
    </StackPane>
</VBox>
